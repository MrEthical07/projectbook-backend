* text=auto eol=lf

# Shell scripts and SQL snapshots must stay LF so they run on Linux CI and so
# the golden schema diff does not spuriously fail on Windows checkouts.
*.sh text eol=lf
*.sql text eol=lf
db/schema.generated.sql text eol=lf
db/migrations/*.sql text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.exe binary
